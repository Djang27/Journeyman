# Copy to backend/.env for local development. backend/.env is gitignored.
#
# Leave both unset and the API falls back to an in-memory session store, which
# is fine for `python app.py` and the test suite but loses every session between
# requests. Production and Preview must set them.
#
# For the local Supabase stack, run `supabase start` from Journeyman/ and use
# the "Project URL" and "SERVICE_ROLE_KEY" it prints. Those are fixed dev
# defaults, identical for every Supabase user, and are not secrets.

SUPABASE_URL=http://127.0.0.1:54321

# WARNING: this key bypasses row level security entirely. It is how the server
# reads `puzzles` and `game_sessions`, which have no client policies at all.
#
#   - never give it a REACT_APP_ prefix (CRA inlines those into the public bundle)
#   - never read it from frontend code
#   - in Vercel, set visibility to Secret, scoped to Production and Preview,
#     with each environment holding its own project's key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# LOCAL ONLY. The local `supabase start` stack still signs tokens with a shared
# HS256 secret, so verification needs it -- use the JWT_SECRET that `supabase
# start` prints.
#
# Do NOT set this for a hosted project. Hosted Supabase now signs with
# asymmetric keys, and their public keys are fetched from SUPABASE_URL
# automatically, so no extra variable is needed in Vercel. A project's legacy
# HS256 secret stays visible in its dashboard after rotation, so accepting it
# alongside asymmetric keys would let anyone holding it forge tokens for any
# user. auth.py refuses HS256 whenever a JWKS URL is available.
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
